# Server Configuration
PORT=5005
FLASK_ENV=development

# Database Settings
# Set DB_TYPE to 'sqlite' (local file) or 'supabase' (uses PostgreSQL connection string)
DB_TYPE=sqlite
# If using supabase, provide your PostgreSQL connection string:
# SUPABASE_DB_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Stripe Credentials
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend Redirect URLs
# Use http://127.0.0.1:5500 for local live-server, or your production URL
FRONTEND_URL=http://localhost:5500

# Email (SMTP) Settings for Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-not-normal-password
BUSINESS_OWNER_EMAIL=owner-email@gmail.com

# Google Calendar Integration (Optional)
# GOOGLE_CALENDAR_ID=owner-email@gmail.com or primary
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
